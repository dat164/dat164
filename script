-- TARGET
local function part(m)
	return m:FindFirstChild("HumanoidRootPart")
		or m:FindFirstChild("UpperTorso")
		or m:FindFirstChild("Torso")
		or m:FindFirstChild("Head")
end

local function find(list)
	local center=cam.ViewportSize/2
	local best,bd=nil,aimFov

	for _,m in ipairs(list)do
		local h=m:FindFirstChildOfClass("Humanoid")
		local p=part(m)
		if h and h.Health>0 and p then
			local s,on=cam:WorldToViewportPoint(p.Position)
			if on then
				local d=(Vector2.new(s.X,s.Y)-center).Magnitude
				if d<bd then best,bd=p,d end
			end
		end
	end
	return best
end

local function players()
	local t={}
	for _,p in ipairs(P:GetPlayers())do
		if p~=me and p.Character then t[#t+1]=p.Character end
	end
	return t
end

local function npcs()
	local t={}
	for _,m in ipairs(workspace:GetDescendants())do
		if m:IsA("Model")
		and not P:GetPlayerFromCharacter(m)
		and m:FindFirstChildOfClass("Humanoid")
		and part(m)then
			t[#t+1]=m
		end
	end
	return t
end

-- AIM
R:BindToRenderStep("MultiAim",Enum.RenderPriority.Camera.Value+1,function(dt)
	if not AIM and not NPC then return end

	local p=find(AIM and players()or npcs())
	if not p then return end

	local pos=p.Position+p.AssemblyLinearVelocity*prediction
	local goal=CFrame.lookAt(cam.CFrame.Position,pos)

	cam.CFrame=cam.CFrame:Lerp(goal,math.clamp(dt*60,0,1))
end)
