local function enableThirdPerson()

    local camera =
        workspace.CurrentCamera

    local character =
        player.Character

    if not camera or not character then
        return
    end

    normalCameraType =
        camera.CameraType

    normalCameraSubject =
        camera.CameraSubject

    normalCameraMinZoom =
        player.CameraMinZoomDistance

    normalCameraMaxZoom =
        player.CameraMaxZoomDistance

    thirdPersonEnabled = true

    camera.CameraType =
        Enum.CameraType.Custom

    camera.CameraSubject =
        character:FindFirstChildOfClass("Humanoid")

    player.CameraMinZoomDistance = 8
    player.CameraMaxZoomDistance = 8
    player.CameraMode = Enum.CameraMode.Classic

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.CameraOffset =
            Vector3.new(0, 1.5, 0)
    end

    thirdToggle.Text =
        "THIRD PERSON : ON"
end

local function disableThirdPerson()

    local camera =
        workspace.CurrentCamera

    local character =
        player.Character

    thirdPersonEnabled = false

    if camera then

        camera.CameraType =
            normalCameraType or
            Enum.CameraType.Custom

        if normalCameraSubject then
            camera.CameraSubject =
                normalCameraSubject
        elseif character then
            camera.CameraSubject =
                character:FindFirstChildOfClass("Humanoid")
        end
    end

    if normalCameraMinZoom then
        player.CameraMinZoomDistance =
            normalCameraMinZoom
    end

    if normalCameraMaxZoom then
        player.CameraMaxZoomDistance =
            normalCameraMaxZoom
    end

    if character then

        local humanoid =
            character:FindFirstChildOfClass("Humanoid")

        if humanoid then
            humanoid.CameraOffset =
                Vector3.new(0, 0, 0)
        end
    end

    thirdToggle.Text =
        "THIRD PERSON : OFF"
end

thirdToggle.MouseButton1Click:Connect(function()

    if thirdPersonEnabled then
        disableThirdPerson()
    else
        enableThirdPerson()
    end
end)

--==================================================
-- TARGET PART
--==================================================

local function getTargetPart(model)

    if not model then
        return nil
    end

    local root =
        model:FindFirstChild("HumanoidRootPart")

    if root and root:IsA("BasePart") then
        return root
    end

    local upperTorso =
        model:FindFirstChild("UpperTorso")

    if upperTorso and upperTorso:IsA("BasePart") then
        return upperTorso
    end

    local torso =
        model:FindFirstChild("Torso")

    if torso and torso:IsA("BasePart") then
        return torso
    end

    local head =
        model:FindFirstChild("Head")

    if head and head:IsA("BasePart") then
        return head
    end

    return nil
end

--==================================================
-- PLAYER TARGET
--==================================================

local function getNearestPlayer()

    local camera =
        workspace.CurrentCamera

    if not camera then
        return nil
    end

    local closest = nil
    local closestDistance = AIM_DISTANCE

    local center =
        Vector2.new(
            camera.ViewportSize.X / 2,
            camera.ViewportSize.Y / 2
        )

    for _, targetPlayer in
        ipairs(Players:GetPlayers()) do

        if targetPlayer ~= player then

            local character =
                targetPlayer.Character

            if character then

                local humanoid =
                    character:FindFirstChildOfClass(
                        "Humanoid"
                    )

                if humanoid and humanoid.Health > 0 then

                    local targetPart =
                        getTargetPart(character)

                    if targetPart then

                        local screenPosition, visible =
                            camera:WorldToViewportPoint(
                                targetPart.Position
                            )

                        if visible and
                            screenPosition.Z > 0 then

                            local distance =
                                (
                                    Vector2.new(
                                        screenPosition.X,
                                        screenPosition.Y
                                    ) - center
                                ).Magnitude

                            if distance <
                                closestDistance then

                                closestDistance =
                                    distance

                                closest =
                                    targetPart
                            end
                        end
                    end
                end
            end
        end
    end

    return closest
end

--==================================================
-- NPC TARGET
--==================================================

local function getNearestNPC()

    local camera =
        workspace.CurrentCamera

    if not camera then
        return nil
    end

    local closest = nil
    local closestDistance = AIM_DISTANCE

    local center =
        Vector2.new(
            camera.ViewportSize.X / 2,
            camera.ViewportSize.Y / 2
        )

    for _, obj in
        ipairs(workspace:GetDescendants()) do

        if obj:IsA("Model") then

            local humanoid =
                obj:FindFirstChildOfClass(
                    "Humanoid"
                )

            if humanoid and humanoid.Health > 0 then

                local isPlayerCharacter = false

                for _, targetPlayer in
                    ipairs(Players:GetPlayers()) do

                    if targetPlayer.Character == obj then
                        isPlayerCharacter = true
                        break
                    end
                end

                if not isPlayerCharacter then

                    local targetPart =
                        getTargetPart(obj)

                    if targetPart then

                        local screenPosition, visible =
                            camera:WorldToViewportPoint(
                                targetPart.Position
                            )

                        if visible and
                            screenPosition.Z > 0 then

                            local distance =
                                (
                                    Vector2.new(
                                        screenPosition.X,
                                        screenPosition.Y
                                    ) - center
                                ).Magnitude

                            if distance <
                                closestDistance then

                                closestDistance =
                                    distance

                                closest =
                                    targetPart
                            end
                        end
                    end
                end
            end
        end
    end

    return closest
end

--==================================================
-- PRECISION AIM
--==================================================

pcall(function()
    RunService:UnbindFromRenderStep(
        "MultiAimPrecision"
    )
end)

RunService:BindToRenderStep(
    "MultiAimPrecision",
    Enum.RenderPriority.Camera.Value + 1,
    function(dt)

        local camera =
            workspace.CurrentCamera

        if not camera then
            return
        end

        local target = nil

        if aimEnabled then
            target = getNearestPlayer()
        elseif npcAimEnabled then
            target = getNearestNPC()
        end

        if not target then
            return
        end

        if not target:IsA("BasePart") then
            return
        end

        local targetPosition =
            target.Position

        local velocity =
            target.AssemblyLinearVelocity

        local predictedPosition =
            targetPosition +
            velocity * AIM_PREDICTION

        local direction =
            predictedPosition -
            camera.CFrame.Position

        if direction.Magnitude <= 0.001 then
            return
        end

        local desired =
            CFrame.lookAt(
                camera.CFrame.Position,
                predictedPosition
            )

        local alpha =
            math.clamp(
                AIM_SMOOTHNESS * dt * 60,
                0,
                1
            )

        camera.CFrame =
            camera.CFrame:Lerp(
                desired,
                alpha
            )
    end
)

