local rainbowConnections = {}

local function rainbowObject(obj)

    if rainbowConnections[obj] then
        return
    end

    local hue = 0

    rainbowConnections[obj] =
        RunService.RenderStepped:Connect(function()

            if not obj.Parent then
                rainbowConnections[obj]:Disconnect()
                rainbowConnections[obj] = nil
                return
            end

            hue = (hue + 0.008) % 1

            obj.BackgroundColor3 =
                Color3.fromHSV(hue, 0.8, 1)
        end)
end

local function stopRainbow(obj)

    if rainbowConnections[obj] then
        rainbowConnections[obj]:Disconnect()
        rainbowConnections[obj] = nil
    end

    obj.BackgroundColor3 =
        Color3.fromRGB(42, 42, 42)
end

